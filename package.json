{
  "name": "tracer",
  "version": "1.0.3",
  "description": "Electrophysiology analysis software",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Marco Ledri",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:python\" \"npm run dev:electron\"",
    "dev:electron": "vite",
    "dev:python": "cd backend && python main.py",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-table": "^8.20.5",
    "@xyflow/react": "^12.3.6",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.460.0",
    "msgpack-lite": "^0.1.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uplot": "^1.6.31",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.tracer.app",
    "productName": "TRACER",
    "copyright": "Copyright © 2026 Marco Ledri. Free for noncommercial use (PolyForm Noncommercial 1.0.0).",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend"
      },
      {
        "from": "build/lockup.png",
        "to": "lockup.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "EpilepsyCenter",
        "repo": "tracer"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
