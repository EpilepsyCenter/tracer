---
import Base from '../layouts/Base.astro';
import TraceDivider from '../components/TraceDivider.astro';
import Lightbox from '../components/Lightbox.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;
const repo = 'https://github.com/EpilepsyCenter/tracer';
const releases = `${repo}/releases`;

// The screenshots live with the manual, in docs/screenshots. Astro hashes and
// copies them into the build, so the site and the manual share one set.
const shotModules = import.meta.glob(
  '../../../docs/screenshots/*.png',
  { eager: true, query: '?url', import: 'default' }
) as Record<string, string>;

const shotUrl = (file: string): string | undefined =>
  Object.entries(shotModules).find(([path]) => path.endsWith('/' + file))?.[1];

// A missing file drops out rather than breaking the build.
const shots = [
  { file: 'main-window-overview.png', caption: 'Main window · recording tree, viewer, results table' },
  { file: 'events-window-overview.png', caption: 'Event detection · template match with per-event fits' },
  { file: 'ap-window-kinetics-tab.png', caption: 'Action potentials · per-AP kinetics and F–I curve' },
  { file: 'trace-export-figure-tab.png', caption: 'Trace export · figure-quality SVG, PDF and PNG' },
]
  .map((s) => ({ ...s, url: shotUrl(s.file) }))
  .filter((s): s is { file: string; caption: string; url: string } => Boolean(s.url));
---
<Base title="TRACER — Patch-clamp & field-recording analysis">
<style>
/* ═══════ HERO ═══════ */
.hero { padding: 64px 0 0; }
.hero h1 {
  font-weight: 600;
  font-size: 60px;
  line-height: 1.02;
  letter-spacing: -0.035em;
  margin: 18px 0 0;
  max-width: 17ch;
  text-wrap: pretty;
}
.hero h1 span { color: var(--accent); }
.hero p.lead {
  font-size: 18px;
  line-height: 1.65;
  color: var(--ink-soft);
  max-width: 60ch;
  margin: 26px 0 0;
}
.hero p.lead .mono {
  color: var(--ink);
  font-size: 15px;
  background: var(--card);
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 0 5px;
}
.hero .cta { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; margin: 30px 0 0; }
.hero .specs { display: flex; gap: 28px; margin: 34px 0 0; flex-wrap: wrap; }
.hero .specs div {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--muted);
}
.hero .specs b { color: var(--ink); font-weight: 500; }

/* ═══════ SHARED SECTION FURNITURE ═══════ */
section { padding: 64px 0; }
section h2 {
  font-size: 32px;
  font-weight: 600;
  letter-spacing: -0.03em;
  margin: 14px 0 0;
  max-width: 24ch;
  line-height: 1.1;
}
section h2 span { color: var(--accent); }
section p.sub { color: var(--ink-soft); font-size: 16px; line-height: 1.65; max-width: 62ch; margin: 16px 0 0; }

/* ═══════ SCREENSHOTS ═══════ */
.shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 26px 0 0; }
.shots figure { margin: 0; }
.shots img {
  width: 100%;
  display: block;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  object-position: top left;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  background: var(--card);
}
.shots figcaption { margin: 11px 0 0; }

/* ═══════ WHAT'S INSIDE ═══════ */
.inside { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 26px 0 0; }
.inside div {
  background: var(--card);
  border: 1px solid var(--rule);
  border-left: 3px solid var(--tracer);
  border-radius: 9px;
  padding: 14px 16px;
}
.inside b { display: block; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
.inside span {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.05em;
  color: var(--muted);
}

/* ═══════ FEATURES ═══════ */
.features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 32px 0 0; }
.feature {
  background: var(--card);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: border-color 0.15s;
}
.feature:hover { border-color: var(--rule-strong); }
.feature .f-head { display: flex; align-items: center; justify-content: space-between; }
.feature .num { font-family: var(--mono); font-size: 11px; color: var(--muted); letter-spacing: 0.07em; }
.feature .icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: color-mix(in srgb, var(--tracer) 7%, #fff);
  color: var(--tracer);
}
.feature h3 { margin: 16px 0 0; font-weight: 600; font-size: 18px; letter-spacing: -0.02em; }
.feature p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
.feature p .mono {
  color: var(--ink);
  font-size: 13px;
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 0 4px;
}
.feature .meta-row {
  margin-top: auto;
  padding-top: 18px;
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

/* ═══════ WORKFLOW ═══════ */
.steps { display: grid; grid-template-columns: 1fr 1fr; gap: 0 36px; margin: 32px 0 0; }
.step {
  padding: 22px 0;
  border-top: 1px solid var(--rule);
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 16px;
  align-items: start;
}
.step .n { font-family: var(--mono); font-size: 11px; color: var(--accent); letter-spacing: 0.07em; padding-top: 4px; }
.step h4 { margin: 0 0 5px; font-weight: 600; font-size: 16px; letter-spacing: -0.015em; }
.step p { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
.step p .mono {
  color: var(--ink);
  font-size: 13px;
  background: var(--card);
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 0 4px;
}

/* ═══════ WHY A NEW TOOL ═══════ */
.why p.body { color: var(--ink-soft); font-size: 17px; line-height: 1.7; max-width: 66ch; margin: 18px 0 0; }
.why .row { display: flex; gap: 6px; flex-wrap: wrap; margin: 22px 0 0; }

/* responsive */
@media (max-width: 900px) {
  .hero h1 { font-size: 42px; }
  section h2 { font-size: 27px; }
  .features, .inside { grid-template-columns: 1fr 1fr; }
  .steps, .shots { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .hero h1 { font-size: 34px; }
  .features, .inside { grid-template-columns: 1fr; }
}
</style>

<!-- ══════ HERO ══════ -->
<div class="scope-zone">
  <header class="hero"><div class="wrap">
    <div class="eyebrow">v1.0.1 · macOS · Windows · Linux</div>
    <h1>Analyze patch-clamp <span>&amp; field recordings.</span></h1>
    <p class="lead">TRACER reads your <span class="mono">.dat</span> and <span class="mono">.abf</span> files, runs the analyses you actually use — events, kinetics, AP counting, fEPSP slopes — and exports clean figures. Locally, offline, on your machine.</p>
    <div class="cta">
      <a class="btn-lg primary" href={releases}>Download v1.0.1</a>
      <a class="btn-lg" href={link('/features')}>See what's inside</a>
    </div>
    <div class="specs">
      <div>Recordings <b>Patch-clamp · field</b></div>
      <div>Licence <b>Free for noncommercial use</b></div>
      <div>Data <b>Stays local</b></div>
    </div>

    <TraceDivider />
  </div></header>
</div>

<!-- ══════ SCREENSHOTS ══════ -->
{shots.length > 0 && (
  <section id="screens">
    <div class="wrap">
      <div class="eyebrow">The instrument</div>
      <h2>One window shape, every analysis.</h2>
      <p class="sub">Recording tree on the left, continuous-mode viewer with draggable cursors in the middle, parameter sidebar and results table on the right. Click any screenshot to see it full size.</p>
      <div class="shots">
        {shots.map((s) => (
          <figure>
            <a class="shot" href={s.url} data-caption={s.caption}>
              <img src={s.url} alt={s.caption} loading="lazy" />
            </a>
            <figcaption class="eyebrow plain">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ══════ WHAT'S INSIDE ══════ -->
<section id="inside">
  <div class="wrap">
    <div class="eyebrow">What's inside</div>
    <div class="inside">
      <div><b>Cursors</b><span>baseline · peak · rise · decay</span></div>
      <div><b>Resistance</b><span>Rs · Rin · Cm · τ</span></div>
      <div><b>I–V curve</b><span>steady · transient · sag</span></div>
      <div><b>Action potentials</b><span>F–I · phase plot · fAHP</span></div>
      <div><b>Events</b><span>template · biexp fit</span></div>
      <div><b>Bursts</b><span>3 detectors · field</span></div>
    </div>
  </div>
</section>

<!-- ══════ FEATURES ══════ -->
<section id="features">
  <div class="wrap">
    <div class="eyebrow">What it does</div>
    <h2>Built around how electrophysiologists <span>actually work.</span></h2>
    <p class="sub">A short list of analysis modules, done carefully. Continuous-mode viewer with draggable cursors, a sidebar of parameters, a results table you can curate. Same shape across every window.</p>

    <div class="features">
      <div class="feature bracketed">
        <div class="f-head">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 64 64" fill="none"><path d="M6 40 H22 C 24 40 26 40 27 34 L 29 22 C 30 17 32 17 33 22 L 36 50 C 37 56 40 56 41 50 L 44 42 H58" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
          <div class="num">01</div>
        </div>
        <h3>Single-cell kinetics</h3>
        <p>Cursor measurements, resistance (Rs/Rin/Cm/τ), I–V curves with sag and reversal, action potentials with threshold, peak, rise/decay slopes, half-width, F–I curve, rheobase, phase plot.</p>
        <div class="meta-row"><span class="chip">V-clamp</span><span class="chip">I-clamp</span><span class="chip">Phase plot</span></div>
      </div>
      <div class="feature bracketed">
        <div class="f-head">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 64 64" fill="none"><path d="M6 50 C 18 50 24 14 32 14 C 40 14 46 50 58 50" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"></path><circle cx="20" cy="32" r="1.8" fill="currentColor"></circle><circle cx="32" cy="14" r="1.8" fill="currentColor"></circle><circle cx="44" cy="32" r="1.8" fill="currentColor"></circle></svg></div>
          <div class="num">02</div>
        </div>
        <h3>Event detection</h3>
        <p>EPSCs, IPSCs, miniature events. Template matching (correlation or deconvolution) and thresholding, with biexponential per-event fits, multi-template detection, manual add/remove, sweep-by-sweep review.</p>
        <div class="meta-row"><span class="chip">Template</span><span class="chip">Biexp</span></div>
      </div>
      <div class="feature bracketed">
        <div class="f-head">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 64 64" fill="none"><path d="M4 32 H60" stroke="currentColor" stroke-width="1" opacity=".4"></path><g stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 14 V50"></path><path d="M22 22 V50"></path><path d="M32 10 V50"></path><path d="M42 26 V50"></path><path d="M52 18 V50"></path></g></svg></div>
          <div class="num">03</div>
        </div>
        <h3>Field &amp; paired</h3>
        <p>fEPSP slope, population spike, paired-pulse ratio, LTP/LTD time-courses in one window. Burst detection with three algorithms on continuous traces. Pre/post detection in two-channel paired recordings.</p>
        <div class="meta-row"><span class="chip">fEPSP</span><span class="chip">Bursts</span><span class="chip">Paired</span></div>
      </div>
      <div class="feature bracketed">
        <div class="f-head">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 64 64" fill="none"><rect x="10" y="14" width="44" height="32" rx="1" stroke="currentColor" stroke-width="2"></rect><path d="M16 36 L24 28 L32 34 L40 22 L48 30" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path><path d="M22 54 H42" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></div>
          <div class="num">04</div>
        </div>
        <h3>Publication figures</h3>
        <p>Trace Export window: figure-quality SVG, PDF, PNG and JPG with templates and saved sessions. Vector output, consistent typography, no re-styling.</p>
        <div class="meta-row"><span class="chip">SVG</span><span class="chip">PDF</span><span class="chip">PNG</span><span class="chip">JPG</span></div>
      </div>
      <div class="feature bracketed">
        <div class="f-head">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 64 64" fill="none"><path d="M14 10 H38 L50 22 V54 H14 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"></path><path d="M38 10 V22 H50" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"></path><path d="M22 34 H42 M22 42 H38" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></div>
          <div class="num">05</div>
        </div>
        <h3>Native formats</h3>
        <p>HEKA Patchmaster <span class="mono">.dat</span>, Axon Binary Format <span class="mono">.abf</span>, plus 50+ other formats via <span class="mono">Neo</span>. No converters, no intermediate CSVs, no data loss.</p>
        <div class="meta-row"><span class="chip">DAT</span><span class="chip">ABF</span><span class="chip">Neo</span></div>
      </div>
      <div class="feature bracketed">
        <div class="f-head">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="22" stroke="currentColor" stroke-width="2"></circle><path d="M32 18 V32 L42 38" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></div>
          <div class="num">06</div>
        </div>
        <h3>Cohort &amp; batch</h3>
        <p>Aggregate across folders of recordings, run two-group / N-group / paired / RM-ANOVA stats with post-hocs, render dot / bar / box / violin / ECDF plots, export to CSV, Excel, and Prism <span class="mono">.pzfx</span>.</p>
        <div class="meta-row"><span class="chip">Cohort</span><span class="chip">Batch</span><span class="chip">Prism</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ══════ WORKFLOW ══════ -->
<section id="workflow">
  <div class="wrap">
    <div class="eyebrow">The workflow</div>
    <h2>Drop a file. Curate the events. <span>Export the figure.</span></h2>

    <div class="steps">
      <div class="step">
        <div class="n">01</div>
        <div><h4>Open a recording</h4><p>Drag an <span class="mono">.abf</span> or <span class="mono">.dat</span> into the workspace. The group → series → sweep tree builds itself; protocols, channel units and timestamps come along.</p></div>
      </div>
      <div class="step">
        <div class="n">02</div>
        <div><h4>Pick an analysis window</h4><p>Cursors, Resistance, I–V, AP, Events, Bursts, Field PSP, Paired — same shape every time. Continuous-mode viewer, draggable cursors, parameter sidebar, results table.</p></div>
      </div>
      <div class="step">
        <div class="n">03</div>
        <div><h4>Review &amp; curate</h4><p>Sweep-by-sweep with detected events highlighted. Accept, reject, re-fit, add or remove by click. Optional <span class="mono">train grouping</span> labels closely-spaced events as <span class="mono">T1, T2…</span>.</p></div>
      </div>
      <div class="step">
        <div class="n">04</div>
        <div><h4>Export &amp; archive</h4><p>Publication-ready SVG / PDF / PNG figures. CSV / Excel / Prism summary tables. A <span class="mono">.tracer</span> sidecar next to the recording — every selection, cursor and parameter, restored on reopen.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ══════ WHY A NEW TOOL ══════ -->
<section id="why" class="why">
  <div class="wrap">
    <div class="eyebrow">Why a new tool</div>
    <p class="body">Patch-clamp analysis tools have been good enough for a long time — and old enough to show. TRACER runs the same working day on a stack you'd actually choose today: a viewer that doesn't stutter on long recordings, filters that update live, a sidecar that records every parameter you used, cohort stats and batch automation in the same app. No licences to renew. No scripts to inherit.</p>
    <div class="row">
      <span class="chip">Sub-second viewer</span>
      <span class="chip">Live filters</span>
      <span class="chip">Reproducible by default</span>
    </div>
    <div class="row">
      <a class="btn" href={link('/features')}>Browse features</a>
      <a class="btn" href={link('/workflow')}>See the workflow</a>
    </div>
  </div>
</section>

<!-- ══════ CLOSING BAND ══════ -->
<section class="band">
  <div class="wrap">
    <div class="eyebrow">v1.0.1 · Released</div>
    <h2>Get back to <span>the science.</span></h2>
    <p>Free for noncommercial use: academic labs, hospitals, nonprofits. macOS Apple Silicon, Windows, and Linux installers built on every release. No account, no telemetry, no upload.</p>
    <div class="btns">
      <a class="btn-lg primary" href={releases}>Download TRACER 1.0.1</a>
      <a class="btn-lg" href={link('/docs')}>Read the docs</a>
    </div>
    <p class="install-note">
      <strong>First launch on macOS:</strong> TRACER isn't notarized by Apple yet, so macOS blocks it the first time.
      Open <strong>System Settings → Privacy &amp; Security</strong> and click <strong>Open Anyway</strong>.
      If macOS says the app <em>"is damaged"</em> (v1.0.0), it isn't. Run
      <code>xattr -dr com.apple.quarantine /Applications/TRACER.app</code> once in Terminal.
    </p>
    <div class="foot-line">
      <span>macOS 12+ Apple Silicon</span>
      <span>Windows 11</span>
      <span>Linux AppImage · x64 / arm64</span>
      <span>Free for noncommercial use</span>
    </div>
  </div>
</section>

<Lightbox />
</Base>
