---
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { marked } from 'marked';
import manualMd from '../../../docs/MANUAL.md?raw';

const repo = 'https://github.com/EpilepsyCenter/tracer';
const releases = `${repo}/releases`;
const manualUrl = `${repo}/blob/main/docs/MANUAL.md`;

const screenshotModules = import.meta.glob(
  '../../../docs/screenshots/*.{png,jpg,jpeg,svg,webp}',
  { eager: true, query: '?url', import: 'default' }
) as Record<string, string>;

const screenshotByName: Record<string, string> = {};
for (const [path, url] of Object.entries(screenshotModules)) {
  const name = path.split('/').pop();
  if (name) screenshotByName[name] = url;
}

const SCREENSHOT_RE = /!\[([^\]]*)\]\(screenshots\/([^)]+)\)/g;

function placeholderCard(name: string): string {
  return '<div class="manual-img-missing"><span class="k">Screenshot pending</span><span class="v">' + name + '</span></div>';
}

const mdWithScreenshots = manualMd.replace(SCREENSHOT_RE, (_m, alt, name) => {
  const url = screenshotByName[name];
  if (url) return '![' + alt + '](' + url + ')';
  return placeholderCard(name);
});

function slugify(s: string): string {
  return s.toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
}

interface Heading { level: number; text: string; id: string; }
function extractHeadings(md: string): Heading[] {
  const out: Heading[] = [];
  const seen = new Map<string, number>();
  const lines = md.split('\n');
  let inFence = false;
  for (const line of lines) {
    if (line.startsWith('```')) { inFence = !inFence; continue; }
    if (inFence) continue;
    const m = /^(#{1,3})\s+(.+?)\s*$/.exec(line);
    if (!m) continue;
    const level = m[1].length;
    const text = m[2].replace(/`/g, '');
    let id = slugify(text);
    const dup = seen.get(id) ?? 0;
    if (dup > 0) id = id + '-' + dup;
    seen.set(slugify(text), dup + 1);
    out.push({ level, text, id });
  }
  return out;
}

const headings = extractHeadings(mdWithScreenshots);
const chapters = headings.filter((h) => h.level === 2);

let html = await marked.parse(mdWithScreenshots, { gfm: true });

{
  const seen = new Map<string, number>();
  html = html.replace(
    /<h([1-3])>([\s\S]*?)<\/h\1>/g,
    (_m, levelStr, inner) => {
      const text = inner.replace(/<[^>]+>/g, '').trim();
      let id = slugify(text);
      const dup = seen.get(id) ?? 0;
      if (dup > 0) id = id + '-' + dup;
      seen.set(slugify(text), dup + 1);
      return '<h' + levelStr + ' id="' + id + '">' + inner + '</h' + levelStr + '>';
    }
  );
}

// Wrap every manual screenshot in a .shot link so the shared <dialog>
// lightbox picks it up — the same viewer the hub and the front page use.
html = html.replace(
  /<img src="([^"]*)" alt="([^"]*)"\s*\/?>/g,
  (_m, src, alt) =>
    '<a class="shot" href="' + src + '" data-caption="' + alt + '">' +
    '<img src="' + src + '" alt="' + alt + '" loading="lazy" /></a>'
);
---
<Base title="TRACER — Manual">
<style>
.doc-layout { display: grid; grid-template-columns: 220px 1fr; gap: 40px; padding: 44px 0 40px; align-items: start; }

aside.side {
  position: sticky;
  top: calc(var(--nav-h) + 20px);
  max-height: calc(100vh - var(--nav-h) - 40px);
  overflow: auto;
  padding-right: 8px;
  font-size: 13.5px;
}
aside.side h5 {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 12px;
}
aside.side h5.tail { margin-top: 26px; }
aside.side ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
aside.side a {
  display: block;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--muted);
  line-height: 1.45;
  transition: background 0.12s, color 0.12s;
}
aside.side a:hover { background: var(--card); color: var(--ink); }

main.doc { min-width: 0; max-width: 760px; }

.doc-header { padding-bottom: 30px; margin-bottom: 36px; border-bottom: 1px solid var(--rule); }
.doc-header .crumb {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 14px;
  display: flex;
  gap: 8px;
  align-items: center;
}
.doc-header h1 { font-weight: 600; font-size: 40px; line-height: 1.05; letter-spacing: -0.032em; margin: 0 0 16px; }
.doc-header h1 span { color: var(--accent); }
.doc-header .lead { color: var(--ink-soft); font-size: 17px; line-height: 1.65; max-width: 62ch; }
.doc-header .meta { margin-top: 20px; display: flex; gap: 7px; flex-wrap: wrap; }

@media (max-width: 900px) {
  .doc-layout { grid-template-columns: 1fr; gap: 24px; }
  aside.side { position: static; max-height: none; }
  .doc-header h1 { font-size: 32px; }
}
</style>

<!-- Manual body styles must be global because the content is
     injected via set:html and won't carry Astro's scope marker. -->
<style is:global>
.manual-body { font-size: 15.5px; line-height: 1.7; color: var(--ink-soft); }
.manual-body > h1 { display: none; }

.manual-body h2 {
  font-weight: 600;
  font-size: 23px;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin: 56px 0 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--rule);
  scroll-margin-top: calc(var(--nav-h) + 20px);
}
.manual-body h3 {
  font-weight: 600;
  font-size: 16px;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 34px 0 10px;
  scroll-margin-top: calc(var(--nav-h) + 20px);
}

.manual-body p { margin: 0 0 14px; }
.manual-body strong { color: var(--ink); font-weight: 600; }
.manual-body em { font-style: italic; }

.manual-body code {
  font-family: var(--mono);
  font-size: 13px;
  background: var(--card);
  padding: 1px 6px;
  border: 1px solid var(--rule);
  border-radius: 4px;
  color: var(--ink);
}
.manual-body pre {
  background: var(--card);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 16px 18px;
  font-family: var(--mono);
  font-size: 12.5px;
  line-height: 1.6;
  overflow: auto;
  margin: 0 0 18px;
}
.manual-body pre code { background: transparent; border: none; padding: 0; font-size: 12.5px; }

.manual-body a { color: var(--accent); }
.manual-body a:hover { text-decoration: underline; }

.manual-body ul, .manual-body ol { padding-left: 22px; margin: 0 0 16px; }
.manual-body li { margin-bottom: 5px; }
.manual-body ul li::marker { color: var(--rule-strong); }

.manual-body table { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: 14px; }
.manual-body th, .manual-body td {
  text-align: left;
  padding: 9px 12px;
  border-bottom: 1px solid var(--rule);
  vertical-align: top;
}
.manual-body th {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}
.manual-body td:first-child, .manual-body td:nth-child(2) { color: var(--ink); }

/* Screenshots are wrapped in .shot links; the viewer styling is shared. */
.manual-body a.shot { margin: 18px 0; }
.manual-body a.shot:hover { text-decoration: none; }
.manual-body img {
  display: block;
  max-width: 100%;
  height: auto;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  background: var(--card);
}

.manual-body kbd {
  font-family: var(--mono);
  font-size: 11.5px;
  background: var(--card);
  border: 1px solid var(--rule);
  border-bottom-width: 2px;
  padding: 1px 6px;
  border-radius: 4px;
  color: var(--ink);
}

.manual-body blockquote {
  border-left: 2px solid var(--accent);
  padding: 10px 16px;
  margin: 0 0 16px;
  background: var(--card);
}

.manual-body hr { border: none; border-top: 1px solid var(--rule); margin: 32px 0; }

.manual-body .manual-img-missing {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 14px 18px;
  margin: 18px auto;
  border: 1px dashed var(--rule-strong);
  border-radius: var(--radius);
  background: var(--card);
  font-family: var(--mono);
  font-size: 11px;
  color: var(--muted);
  max-width: 520px;
}
.manual-body .manual-img-missing .k {
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--ink-soft);
}
</style>

<div class="scope-zone">
<header class="page-hd"><div class="wrap">
  <div>
    <div class="eyebrow">Documentation · v1.0.1</div>
    <h1>The user <span>manual.</span></h1>
    <p class="sub">The full in-app manual, served from <a href={manualUrl}><code>docs/MANUAL.md</code></a> in the repository.</p>
  </div>
  <div class="meta">
    <span><strong>{chapters.length}</strong> chapters</span>
    <span><strong>v1.0.1</strong> current</span>
    <span class="led">Single page</span>
  </div>
</div></header>
</div>

<div class="wrap doc-layout">
  <aside class="side">
    <h5>Chapters</h5>
    <ul>
      {chapters.map((c) => (
        <li><a href={`#${c.id}`}>{c.text}</a></li>
      ))}
    </ul>
    <h5 class="tail">Source</h5>
    <ul>
      <li><a href={manualUrl}>docs/MANUAL.md</a></li>
      <li><a href={repo}>Repository</a></li>
      <li><a href={releases}>Releases</a></li>
    </ul>
  </aside>

  <main class="doc">
    <div class="doc-header">
      <div class="crumb"><span>Docs</span><span style="opacity:.4;">/</span><span>User manual</span></div>
      <h1>TRACER <span>user manual.</span></h1>
      <p class="lead">Open a recording, navigate the group → series → sweep tree, and run the analysis modules over the trace. Below is the complete in-app reference — {chapters.length} chapters covering every analysis window, the persistence model, and the keyboard shortcuts.</p>
      <div class="meta">
        <span class="chip">v1.0.1</span>
        <span class="chip">macOS · Linux · Windows</span>
        <span class="chip">Free for noncommercial use</span>
      </div>
    </div>

    <article class="manual-body" set:html={html}></article>
  </main>
</div>

<Lightbox />
</Base>
